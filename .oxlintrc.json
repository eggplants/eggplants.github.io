{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "oxc", "unicorn", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  // docs/js/index.js runs as a classic script in the browser
  "env": {
    "builtin": true,
    "browser": true
  },
  "rules": {
    "no-undef": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "smart"],
    "no-implicit-globals": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    // Everything lives in one IIFE to stay off window; hoisting helpers out of it defeats that
    "unicorn/consistent-function-scoping": "off"
  }
}
